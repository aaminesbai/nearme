# API server
PORT=3000
DATABASE_POOL_MAX=12
DATABASE_URL=postgresql://nearme:nearme_local_only@localhost:55432/nearme
DEMO_MODE=true
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
TRUST_PROXY_HOPS=0
# Optional enhanced Expo push security token; server-side only.
EXPO_ACCESS_TOKEN=

# Expo app
# Replace the example address with your computer's LAN IPv4 for Expo Go.
EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_DEMO_MODE=true
# Public CARTO key for web map tiles; it is visible in browser requests.
EXPO_PUBLIC_CARTO_API_KEY=cb1_418c_1_db55e532103d93292e10e32c
# Set after running eas init if you enable remote push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional Android maps and FCM setup.
GOOGLE_MAPS_API_KEY=
GOOGLE_SERVICES_JSON=
