{
  "name": "@nearme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate --config prisma7.config.ts && tsx watch src/main.ts",
    "start": "prisma generate --config prisma7.config.ts && tsx src/main.ts",
    "typecheck": "prisma generate --config prisma7.config.ts && tsc --noEmit",
    "migrate": "prisma migrate deploy --config prisma7.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "migrate:baseline": "prisma migrate resolve --applied 00000000000000_baseline --config prisma7.config.ts",
    "generate": "prisma generate --config prisma7.config.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "@nearme/shared": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "latest",
    "expo-server-sdk": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "socket.io": "latest",
    "tsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/pg": "latest",
    "prisma": "7.10.0",
    "socket.io-client": "latest"
  }
}
