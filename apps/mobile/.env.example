# Physical phones: replace localhost with your computer's LAN IPv4. Same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEMO_MODE=true
# Public CARTO basemap key; it is visible in web requests and the browser bundle.
EXPO_PUBLIC_CARTO_API_KEY=cb1_418c_1_db55e532103d93292e10e32c
# Run eas init and put your actual project UUID here for remote push:
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android Google Maps SDK key; restrict to your package and signing certificate:
GOOGLE_MAPS_API_KEY=
# Path to your Firebase Cloud Messaging configuration (push transport only; no Firebase backend):
GOOGLE_SERVICES_JSON=
