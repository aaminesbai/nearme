{
  "cli": { "version": ">=16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DEMO_MODE": "true" }
    },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_DEMO_MODE": "true" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_DEMO_MODE": "false" } }
  }
}
